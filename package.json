{
  "name": "dsh-session-delete",
  "version": "0.0.1",
  "private": true,
  "description": "DeepSeek Harness 插件：侧栏会话菜单增加「移到回收站」，删除的会话在回收站保留若干天（可配置）并可恢复，到期或手动删除才永久清除。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete-session",
    "context-menu"
  ],
  "author": "Ronnie-Young",
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ronnie-Young/dsh-session-delete.git"
  },
  "homepage": "https://github.com/Ronnie-Young/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/Ronnie-Young/dsh-session-delete/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
